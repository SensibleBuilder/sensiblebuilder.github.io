---
import Layout from '~/layouts/PageLayout.astro';

import AtroposComponent from '~/components/ui/AtroposComponent.svelte';
import Carousel from '~/components/widgets/Carousel.svelte';

import Headline from '~/components/blog/Headline.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Note from '~/components/widgets/Note.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

import { Image } from 'astro:assets';
import carouselImage1 from '~/assets/images/TopBanner_Bellevue_Kitchen.jpg';
import carouselImage2 from '~/assets/images/TopBanner_Seattle_Kitchen.jpg';
import carouselImage3 from '~/assets/images/TopBanner_Seattle_MB.jpg';

import galleryImg1 from '~/assets/images/WholeHouse/Bellevue/WH_Bellevue_Front.jpg';
import galleryImg2 from '~/assets/images/WholeHouse/Bellevue/WH_Bellevue_Kitchen.jpg';
import galleryImg3 from '~/assets/images/WholeHouse/Bellevue/WH_Bellevue_MB.jpg';
import galleryImg4 from '~/assets/images/WholeHouse/Bellevue/WH_Bellevue_Stair.jpg';

const metadata = {
  title: 'Sensible Builder - Custom Homes, Additions, Renovations',
  ignoreTitleTemplate: true,  
};

---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero2
    actions={[
      {
        variant: 'primary',
        text: 'Get your quote today',
        href: '#contact',
        icon: 'tabler:phone',
      }
    ]}
    image={{ src: '~/assets/images/WH-Seattle-Patio.jpg', alt: 'A beautiful covered patio with stone tile floor.  ' }}
  >

    <Fragment slot="title">
      <span class="inline">Looking for a</span>
      <span class="block">
        <span class="text-accent dark:text-indigo-400"> Custom Home</span>?
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold block">Your dream home doesn't have to stay a dream.</span>  
      <span class="mb-1 hidden sm:inline"> With over 20 years of experience and dozens of happy clients, we're right at home with our network of architects and suppliers.</span>
    </Fragment>

  </Hero2>
  
  <!-- Note Widget ******************* -->

  <Note title="Where We Work:" description="We operate in the Greater Seattle WA area, including Bothell, Bellevue, and more." />

  <!-- Gallery -->
  <WidgetWrapper containerClass="relative inline-block max-w-full">
    <Headline title={"Your Vision is Our Reality"} subtitle={"Our services cover everything from custom homes to remodels and additions."}/>
    <div class="lg:w-5/6 mx-auto  ">
      <AtroposComponent client:load>
        <Carousel client:load>
          <swiper-slide>
            <Image src={carouselImage1} alt="Sensible Builder logo." />
          </swiper-slide>
          <swiper-slide>
            <Image src={carouselImage2} alt="Sensible Builder logo." />
          </swiper-slide>
          <swiper-slide>
            <Image src={carouselImage3} alt="Sensible Builder logo." />
          </swiper-slide>
        </Carousel>
      </AtroposComponent>
    </div>
  </WidgetWrapper>

  <Headline title="Hello, World!" />

  <!-- Gallery -->

    <WidgetWrapper>
      <div id="gallery" class="mx-auto grid flex-row grid-cols-2 gap-8">
        <Image src={galleryImg1} alt="Sensible Builder logo." />
        <Image src={galleryImg2} alt="Sensible Builder logo." />
        <Image src={galleryImg3} alt="Sensible Builder logo." />
        <Image src={galleryImg4} alt="Sensible Builder logo." />
      </div>
  </WidgetWrapper>

  <!-- About Us -->

  <Steps2
    title="Our values"
    subtitle="As homeowners, we understand that contracting is a huge and potentially frustrating endeavour. That's why we work closely with our clients to ensure that homes are designed with the utmost care."
    items={[
      {
        title: 'Customer-centric Process',
        description:
          'We pride ourselves on communication, fast response times, and in-depth discussions to keep you in the loop. Letting your voice be heard is our top priority.',
        icon: 'tabler:users'
      },
      {
        title: 'Holistic Design',
        description:
          'Our approach to designing houses takes into consideration a wide variety of factors, from eco-friendliness and material efficiency to interior and psychological design.',
        icon: 'tabler:home'
      },
      {
        title: 'Passion',
        description:
          'Every project we take is more than just a house to us. We know how important homes are to everyone, whether for yourself or for your family.',
        icon: 'tabler:heart'
      },
    ]}
    id="about"
  />

  <!-- Contact 

  <Features2
    title="Contact Us"
    subtitle='Call now for a free consultation - leave us a message and we will get back to you as soon as possible.'
    isAfterContent={true}
    items={[
      {
        title: 'Phone',
        description: '+1 (206) 694-3882',
        icon: 'tabler:headset',
      },
      {
        title: 'Email',
        description: 'jerry@sensiblebuilder.com',
        icon: 'tabler:mail',
      },
      {
        title: 'WeChat',
        description: '@jhz5947',
        icon: 'tabler:brand-wechat'
      }
    ]}
    id="contact"
  />

  <ContactUs
    id="form"
    title="Or drop us a message today!"
    subtitle="For quicker answers, please feel free to call the number above."
    inputs={[
      {
        type: 'hidden',
        name: 'access_key',
        value: '5038e0b2-0a2b-460c-aac6-4c7b03b6b16c', // jerry@sensiblebuilder.com
      },
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        required: true,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        required: true,
      },
    ]}
    textarea={{
      label: 'Message',
      required: true,
    }}
    disclaimer={{
      label:
        'I acknowledge and agree to the Privacy Policy.',
    }}
    description="Responses are usually expected within 12 business hours."
  />

  <!- Features Widget 

  <Features
    id="features"
    tagline="Features"
    title="What you get with AstroWind"
    subtitle="One of the most professional and comprehensive templates currently on the market. Most starred & forked Astro theme in 2022, 2023 and 2024."
    items={[
      {
        title: 'Astro + Tailwind CSS Integration',
        description:
          'A seamless integration between two great frameworks that offer high productivity, performance and versatility.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'Ready-to-use Components',
        description:
          'Widgets made with Tailwind CSS ready to be used in Marketing Websites, SaaS, Blogs, Personal Profiles, Small Business...',
        icon: 'tabler:components',
      },
      {
        title: 'Best Practices',
        description:
          'Creating secure, efficient, and user-friendly websites that deliver exceptional experiences and lasting value.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Excellent Page Speed',
        description:
          'Having a good page speed impacts organic search ranking, improves user experience (UI/UX) and increase conversion rates.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Search Engine Optimization (SEO)',
        description:
          "SEO lies in its ability to enhance a website's visibility, driving organic traffic and enabling it to reach a wider audience.",
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Open to new ideas and contributions',
        description:
          'Embracing a culture that is open to new ideas and contributions is integral fostering innovation, collaboration, and a dynamic user experience.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!- Content Widget 

  <Content
    isReversed
    tagline="Inside template"
    title="AstroWind's Blueprint: Fun Meets Functionality!"
    items={[
      {
        title: 'Built on top of Astro 5.0',
        description:
          'Benefiting from the performance and developer-friendly features of this modern static site generator.',
      },
      {
        title: 'Styled using Tailwind CSS',
        description:
          'Facilitating rapid design and consistent styling with this highly popular utility-first CSS framework.',
      },
      {
        title: 'Cross-browser compatibility',
        description:
          'Ensure your website looks and functions consistently across various web browsers, delivering a seamless experience to all users.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Building on modern foundations</h3>
      Gain a competitive advantage by incorporating industry leading practices
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** 

  <Content
    isAfterContent
    items={[
      {
        title: 'High level of customization',
        description: `Tailor the template effortlessly to match your brand's identity and requirements, making your website distinct and saving you time.`,
