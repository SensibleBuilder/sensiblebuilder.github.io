---
import Layout from '~/layouts/PageLayout.astro';

import AtroposComponent from '~/components/ui/AtroposComponent.svelte';
import Carousel from '~/components/widgets/Carousel.svelte';

import Contact from '~/components/widgets/Contact.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Masonry from '~/components/ui/Masonry.astro';
import Note from '~/components/widgets/Note.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import RotatingText from '~/components/ui/RotatingText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

import { Image } from 'astro:assets';
import carouselImage1 from '~/assets/images/TopBanner_Bellevue_Kitchen.jpg';
import carouselImage2 from '~/assets/images/TopBanner_Seattle_Kitchen.jpg';
import carouselImage3 from '~/assets/images/TopBanner_Seattle_MB.jpg';

import galleryImg1 from '~/assets/images/WholeHouse/Bellevue/WH_Bellevue_Front.jpg';
import galleryImg2 from '~/assets/images/WholeHouse/Bellevue/WH_Bellevue_Kitchen.jpg';
import galleryImg3 from '~/assets/images/WholeHouse/Bellevue/WH_Bellevue_MB.jpg';
import galleryImg4 from '~/assets/images/WholeHouse/Bellevue/WH_Bellevue_Stair.jpg';
import galleryImg5 from '~/assets/images/WholeHouse/Seattle/WH_Seattle_Front.jpg';
import galleryImg6 from '~/assets/images/WholeHouse/Seattle/WH_Seattle_Patio.jpg';
import galleryImg7 from '~/assets/images/Addition/Bellevue/Addition_Bellevue_Kitchen.jpg';
import galleryImg8 from '~/assets/images/Addition/Kirkland/Addition_Kirkland_Sitting.jpg';
import galleryImg9 from '~/assets/images/Remodeling/MercerIsland/Remodel_MI_Stairs.jpg';
import galleryImg10 from '~/assets/images/Remodeling/Seattle/RM_Seattle_Vanity.jpg';

const metadata = {
  title: 'Sensible Builder - Custom Homes, Additions, Renovations',
  ignoreTitleTemplate: true,
};

const carouselImages = [
  { src: carouselImage1, alt: 'Bellevue kitchen with custom cabinetry.' },
  { src: carouselImage2, alt: 'Seattle kitchen renovation with open layout.' },
  { src: carouselImage3, alt: 'Seattle primary suite with textured finishes.' },
];

const masonryImages = [
  { src: galleryImg1, alt: 'Front elevation of a custom Bellevue whole-house project.', span: 'lg', speed: 0.08 },
  { src: galleryImg2, alt: 'Bellevue whole-house kitchen with modern finishes.', span: 'xl', speed: 0.14 },
  { src: galleryImg3, alt: 'Bellevue primary bathroom detail shot.', span: 'md', speed: 0.12 },
  { src: galleryImg4, alt: 'Bellevue staircase with natural light.', span: 'lg', speed: 0.18 },
  { src: galleryImg5, alt: 'Seattle project front facade on a bright day.', span: 'md', speed: 0.16 },
  { src: galleryImg6, alt: 'Covered patio transition space in Seattle residence.', span: 'xl', speed: 0.1 },
  { src: galleryImg7, alt: 'Bellevue addition kitchen with warm wood tones.', span: 'lg', speed: 0.22 },
  { src: galleryImg8, alt: 'Kirkland addition sitting area with layered texture.', span: 'md', speed: 0.12 },
  { src: galleryImg9, alt: 'Mercer Island remodel staircase and wall detailing.', span: 'xl', speed: 0.2 },
  { src: galleryImg10, alt: 'Seattle remodel vanity and mirror composition.', span: 'lg', speed: 0.14 },
];
---

<Layout metadata={metadata}>
  <Hero2
    actions={[
      {
        variant: 'primary',
        text: 'Get your quote today',
        href: '#contact',
        icon: 'tabler:phone',
      },
    ]}
    image={{ src: '~/assets/images/WH-Seattle-Patio.jpg', alt: 'A beautiful covered patio with stone tile floor.' }}
  >
    <Fragment slot="title">
      <span class="block">
        <span class="inline pb-2">Looking for a</span>
        <span class="hero-title text-indigo-400 my-2">
          <RotatingText
            prefix=""
            items={['Custom Home?', 'Commercial Building?', 'Renovation?', 'New Addition?']}
            hold={2}
            speed={0.4}
            enterEase="back.out(2)"
          />
        </span>
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold block">Your dream home doesn't have to stay a dream.</span>
      <span class="mb-1 hidden sm:inline">
        We've worked with hundreds of clients over 20 years with our network of architects and suppliers. We'd love to
        have your business too.
      </span>
    </Fragment>
  </Hero2>

  <Note
    title="Go Seattle!"
    description="We operate in the Greater Seattle WA area, including Medina, Clyde Hill, Bellevue, Bothell and Seattle proper."
  />

  <WidgetWrapper id="gallery" containerClass="relative inline-block max-w-full">
    <header class="mb-8 md:mb-16 text-center max-w-3xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading" data-gsap-text>
        <span>Your</span>
        <span class="js-title-keyword">Vision</span>
        <span>is Our</span>
        <span class="js-title-keyword">Reality</span>
      </h2>
      <p class="mt-2 md:mt-3 mx-auto text-xl text-gray-500 dark:text-slate-400 font-medium">
        We take on both commercial and personal projects as a leading PNW contractor. See for yourself!
      </p>
    </header>

    <div class="lg:w-5/6 mx-auto">
      <AtroposComponent client:load>
        <Carousel client:load>
          {
            carouselImages.map((image, index) => (
              <swiper-slide key={index}>
                <Image src={image.src} alt={image.alt} />
              </swiper-slide>
            ))
          }
        </Carousel>
      </AtroposComponent>
    </div>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-full">
    <Masonry
      breakpointCols={{
        default: 3,
        1200: 3,
        700: 2,
      }}
      class="flex gap-4 px-4"
      columnClass=""
    >
      {
        masonryImages.map((item, index) => (
          <figure
            class:list={['sb-masonry-card', `sb-span-${item.span}`]}
            data-speed={item.speed}
            data-fullscreen-toggle
            tabindex="0"
            role="button"
            aria-label={`Open ${item.alt} in full screen`}
            aria-expanded="false"
          >
            <Image
              src={item.src}
              alt={item.alt}
              class="sb-masonry-image"
              widths={[400, 640, 960, 1200]}
              sizes="(max-width: 768px) 75vw, 22vw"
              loading={index < 3 ? 'eager' : 'lazy'}
            />
          </figure>
        ))
      }
    </Masonry>
  </WidgetWrapper>

  <Steps2
    title="Why <span class='js-title-keyword'>us</span>?"
    subtitle="As homeowners, we understand that contracting is a huge and potentially frustrating endeavor. That's why we work closely with our clients to ensure that you always know the how, when, and why of each part of the process."
    items={[
      {
        title: 'Customers First',
        description:
          'We pride ourselves on communication, communication, and more communication. Letting your voice be heard is our top priority.',
        icon: 'tabler:users',
      },
      {
        title: 'Holistic Design',
        description:
          'We design houses with a wide variety of factors, from eco-friendliness and material efficiency to interior and psychological design.',
        icon: 'tabler:home',
      },
      {
        title: 'Passion',
        description:
          'We know how important homes are to everyone, whether for yourself or for your family. Every house deserves our greatest effort.',
        icon: 'tabler:heart',
      },
    ]}
    id="about"
  />
  <Contact
    id="contact"
    title="Contact Us"
    subtitle="Drop us a message today and we'll get you started!"
    button="Submit"
    accessKey="04d0e42b-42d9-4d7e-9c1b-a536b8744bfc"
    successMessage="Thanks for reaching out! We'll be in touch within 24 hours."
    errorMessage="Oops! Something went wrong. Please try again later."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        required: true,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        required: false,
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Phone',
        required: false,
      },
    ]}
    textarea={{
      label: 'Message',
      required: true,
    }}
    description="Responses are usually expected within 12 business hours."
  />
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== 'undefined') {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) {
      document.querySelectorAll('[data-gsap-text]').forEach((heading) => {
        const words = [...heading.querySelectorAll('span')];
        const keywords = [...heading.querySelectorAll('.js-title-keyword')];

        if (words.length) {
          gsap.fromTo(
            words,
            { yPercent: 30, opacity: 0, rotateX: -25, transformOrigin: '50% 100%' },
            {
              yPercent: 0,
              opacity: 1,
              rotateX: 0,
              duration: 0.9,
              ease: 'power3.out',
              stagger: 0.06,
              scrollTrigger: {
                trigger: heading,
                start: 'top 88%',
                toggleActions: 'play none none reverse',
              },
            }
          );
        }

        keywords.forEach((keyword, index) => {
          gsap.fromTo(
            keyword,
            { scale: 0.9, filter: 'blur(4px)', opacity: 0.7 },
            {
              scale: 1,
              filter: 'blur(0px)',
              opacity: 1,
              color: 'rgb(14 165 233)',
              duration: 0.85,
              delay: Math.min(index * 0.08, 0.2),
              ease: 'power2.out',
              scrollTrigger: {
                trigger: heading,
                start: 'top 88%',
                toggleActions: 'play none none reverse',
              },
            }
          );
        });
      });
    }
  }
</script>

<style>
  :global([data-gsap-text] span) {
    display: inline-block;
    transform-style: preserve-3d;
  }

  :global(.js-title-keyword) {
    will-change: transform, filter;
  }
  .sb-masonry-card {
    will-change: transform, opacity;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
    overflow: hidden;
  }
</style>
