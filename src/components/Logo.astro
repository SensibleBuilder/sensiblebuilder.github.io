---
import { Image } from 'astro:assets';
import logoImage from '~/assets/images/SB-logo.png';
import { SITE } from 'astrowind:config';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
>
  <Image src={logoImage} alt="Sensible Builder logo." class="inline-block w-auto h-12 dark:hidden" />
  <span class="invisible dark:visible">{SITE?.name}</span>
</span>
