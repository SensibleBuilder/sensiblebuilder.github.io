---
interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
}

const {
  id,
  title = 'Interactive 3D Preview Lab',
  subtitle = 'WebGPU-powered placeholder ready for your model import pipeline and custom shader experiments.',
} = Astro.props;
---

<section class="sb-model-shell" {...(id ? { id } : {})}>
  <div class="sb-model-copy">
    <h2 class="sb-model-title" data-gsap-text>
      <span>Interactive</span> <span class="js-title-keyword">WebGPU</span> <span>Model Stage</span>
    </h2>
    <p class="sb-model-subtitle">{subtitle}</p>
    <ul class="sb-model-checklist">
      <li>Orbit controls: drag to rotate, wheel/pinch to zoom.</li>
      <li>Placeholder object can be replaced with your GLB/GLTF model.</li>
      <li>Shader hook is prepared for custom material experiments.</li>
    </ul>
  </div>

  <div class="sb-model-stage">
    <canvas class="sb-model-canvas" aria-label="3D model preview canvas"></canvas>
    <div class="sb-model-badge">WebGPU Stage</div>
  </div>
</section>

<script>
  import * as THREE from 'three';
  import { WebGPURenderer } from 'three/webgpu';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== 'undefined' && !window.__sbModelViewportInitialized) {
    window.__sbModelViewportInitialized = true;

    document.querySelectorAll('.sb-model-shell').forEach((shell) => {
      if (shell.dataset.ready === 'true') return;
      shell.dataset.ready = 'true';

      const canvas = shell.querySelector('.sb-model-canvas');
      const stage = shell.querySelector('.sb-model-stage');
      if (!canvas || !stage) return;

      if (!navigator.gpu) {
        stage.insertAdjacentHTML(
          'beforeend',
          '<p class="sb-model-fallback">WebGPU is not available in this browser yet. The section is ready and will activate automatically where WebGPU is supported.</p>'
        );
        return;
      }

      const scene = new THREE.Scene();
      scene.background = null;

      const camera = new THREE.PerspectiveCamera(40, stage.clientWidth / stage.clientHeight, 0.1, 100);
      camera.position.set(2.6, 1.4, 3.2);

      const renderer = new WebGPURenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(stage.clientWidth, stage.clientHeight);

      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = true;
      controls.enablePan = false;
      controls.minDistance = 1.2;
      controls.maxDistance = 6;
      controls.minPolarAngle = 0.35;
      controls.maxPolarAngle = Math.PI - 0.35;

      const keyLight = new THREE.DirectionalLight(0xffffff, 1.3);
      keyLight.position.set(3, 4, 3);
      scene.add(keyLight);

      const fillLight = new THREE.DirectionalLight(0x93c5fd, 0.75);
      fillLight.position.set(-3, 2, -2);
      scene.add(fillLight);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.32);
      scene.add(ambientLight);

      // Placeholder mesh: swap this with your GLTF model load pipeline.
      const geometry = new THREE.IcosahedronGeometry(0.95, 2);
      const material = new THREE.MeshStandardMaterial({
        color: 0x38bdf8,
        roughness: 0.24,
        metalness: 0.58,
      });

      // Shader extension hook for custom visual experiments.
      material.onBeforeCompile = (shader) => {
        shader.fragmentShader = shader.fragmentShader.replace(
          '#include <dithering_fragment>',
          'gl_FragColor.rgb += vec3(0.02 * sin(vViewPosition.y * 8.0));\n#include <dithering_fragment>'
        );
      };

      const mesh = new THREE.Mesh(geometry, material);
      scene.add(mesh);

      const clock = new THREE.Clock();
      const animate = () => {
        const elapsed = clock.getElapsedTime();
        mesh.rotation.y = elapsed * 0.34;
        mesh.rotation.x = Math.sin(elapsed * 0.5) * 0.12;
        controls.update();
        renderer.render(scene, camera);
      };

      renderer.setAnimationLoop(animate);

      const resizeObserver = new ResizeObserver(() => {
        const width = stage.clientWidth;
        const height = stage.clientHeight;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
      });

      resizeObserver.observe(stage);

      gsap.fromTo(
        stage,
        { opacity: 0, y: 44, rotateX: 8 },
        {
          opacity: 1,
          y: 0,
          rotateX: 0,
          duration: 1.1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: shell,
            start: 'top 82%',
            toggleActions: 'play none none reverse',
          },
        }
      );
    });
  }
</script>

<style>
  .sb-model-shell {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 1.5rem;
    align-items: stretch;
    max-width: min(1400px, 95vw);
    margin: 0 auto;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background:
      linear-gradient(155deg, rgb(248 250 252), rgb(241 245 249)),
      radial-gradient(circle at 12% 12%, rgb(125 211 252 / 20%), transparent 35%);
    border: 1px solid rgb(226 232 240);
  }

  :global(.dark) .sb-model-shell {
    background:
      linear-gradient(155deg, rgb(2 6 23), rgb(15 23 42)),
      radial-gradient(circle at 12% 12%, rgb(56 189 248 / 12%), transparent 35%);
    border-color: rgb(30 41 59);
  }

  .sb-model-title {
    font-size: clamp(1.75rem, 3vw, 3rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .sb-model-subtitle {
    margin-top: 0.85rem;
    color: rgb(100 116 139);
  }

  :global(.dark) .sb-model-subtitle {
    color: rgb(148 163 184);
  }

  .sb-model-checklist {
    margin-top: 1rem;
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    color: rgb(51 65 85);
    font-size: 0.95rem;
  }

  :global(.dark) .sb-model-checklist {
    color: rgb(203 213 225);
  }

  .sb-model-checklist li {
    position: relative;
    padding-left: 1rem;
  }

  .sb-model-checklist li::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: rgb(14 165 233);
    position: absolute;
    left: 0;
    top: 0.45rem;
  }

  .sb-model-stage {
    position: relative;
    min-height: clamp(300px, 56vw, 520px);
    border-radius: 1.2rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 16%, rgb(56 189 248 / 24%), transparent 42%),
      radial-gradient(circle at 85% 86%, rgb(37 99 235 / 28%), transparent 40%),
      linear-gradient(160deg, rgb(15 23 42), rgb(2 6 23));
    border: 1px solid rgb(51 65 85);
    transform-style: preserve-3d;
  }

  .sb-model-canvas {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
  }

  .sb-model-badge {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: rgb(186 230 253);
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(125 211 252 / 45%);
    background: rgb(2 6 23 / 45%);
    backdrop-filter: blur(4px);
  }

  .sb-model-fallback {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.9rem;
    margin: 0;
    color: rgb(226 232 240);
    font-size: 0.88rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(148 163 184 / 42%);
    background: rgb(15 23 42 / 60%);
    padding: 0.7rem 0.8rem;
  }

  @media (max-width: 980px) {
    .sb-model-shell {
      grid-template-columns: 1fr;
      padding: 1rem;
    }

    .sb-model-stage {
      min-height: 360px;
    }
  }
</style>