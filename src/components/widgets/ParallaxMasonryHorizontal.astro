---
import { Image } from 'astro:assets';

interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  speed?: number;
  span?: 'sm' | 'md' | 'lg' | 'xl';
}

interface Props {
  title?: string;
  subtitle?: string;
  items: GalleryItem[];
  id?: string;
}

const { title = 'Project Gallery', subtitle = 'Explore signature spaces crafted with depth, light, and detail.', items, id } = Astro.props;
const spanPattern: Array<GalleryItem['span']> = ['md', 'lg', 'sm', 'xl', 'md', 'lg', 'sm', 'md'];

const galleryItems = items.map((item, index) => ({
  ...item,
  speed: item.speed ?? 0.08 + (index % 5) * 0.06,
  span: item.span ?? spanPattern[index % spanPattern.length],
}));
---

<section class="sb-masonry-shell" {...(id ? { id } : {})}>
  <header class="sb-masonry-header">
    <h2 class="sb-masonry-title" data-gsap-text>
      <span>Horizontal</span> <span class="js-title-keyword">Masonry</span> <span>Gallery</span>
    </h2>
    <p class="sb-masonry-subtitle">{subtitle}</p>
  </header>

  <div class="sb-masonry js-sb-masonry">
    <div class="sb-masonry-track">
      {
        galleryItems.map((item, index) => (
          <figure class:list={['sb-masonry-card', `sb-span-${item.span}`]} data-speed={item.speed}>
            <Image
              src={item.src}
              alt={item.alt}
              class="sb-masonry-image"
              widths={[400, 640, 960, 1200]}
              sizes="(max-width: 768px) 75vw, 22vw"
              loading={index < 3 ? 'eager' : 'lazy'}
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initHorizontalMasonry = () => {
    if (typeof window === 'undefined') return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('.js-sb-masonry').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const track = root.querySelector('.sb-masonry-track');
      const cards = [...root.querySelectorAll('.sb-masonry-card')];
      if (!track || cards.length === 0) return;

      if (reducedMotion) {
        gsap.set(cards, { clearProps: 'all' });
        return;
      }

      // Calculate the exact distance the track needs to move left
      const getScrollDistance = () => Math.max(0, track.scrollWidth - root.clientWidth);

      const horizontalTween = gsap.to(track, {
        x: () => -getScrollDistance(),
        ease: 'none',
        scrollTrigger: {
          trigger: root,
          start: 'top top',
          end: () => `+=${getScrollDistance()}`,
          pin: true,
          scrub: true, // Changed from 1 to true for 1:1 scroll response (eliminates "catch-up" snap)
          invalidateOnRefresh: true,
          // anticipatePin: 1 removed - this is the primary cause of vertical snapping on pin engagement
        },
      });

      cards.forEach((card, index) => {
        const speed = Number(card.dataset.speed ?? '0.1');

        // Entry animation: Simplified to opacity only to prevent transform matrix conflicts
        gsap.fromTo(
          card,
          { opacity: 0 },
          {
            opacity: 1,
            duration: 0.8,
            delay: Math.min(index * 0.04, 0.3),
            ease: 'power2.out',
            immediateRender: false,
            scrollTrigger: {
              trigger: card,
              containerAnimation: horizontalTween,
              start: 'left 85%',
              toggleActions: 'play none none reverse',
            },
          }
        );

        // Parallax animation: Using 'y' instead of 'yPercent' for better GPU compositing
        gsap.to(card, {
          y: () => -card.offsetHeight * speed * 1.5, 
          ease: 'none',
          scrollTrigger: {
            trigger: card,
            containerAnimation: horizontalTween,
            start: 'left right',
            end: 'right left',
            scrub: true,
          },
        });
      });
    });
  };

  if (typeof window !== 'undefined') {
    initHorizontalMasonry();
    document.addEventListener('astro:page-load', initHorizontalMasonry);
    
    // Crucial: Refresh ScrollTrigger after all images load to recalculate track.scrollWidth
    // This prevents the layout shift "snap" that occurs when lazy images finish loading.
    window.addEventListener('load', () => {
      ScrollTrigger.refresh();
    });
  }
</script>

<style>
  .sb-masonry-shell {
    max-width: min(1600px, 96vw);
    margin: 0 auto;
    padding: 2rem 0;
  }

  .sb-masonry-header {
    max-width: 62ch;
    margin: 0 0 1.25rem;
  }

  .sb-masonry-title {
    font-size: clamp(1.9rem, 3vw, 3.4rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .sb-masonry-subtitle {
    margin-top: 0.8rem;
    color: rgb(100 116 139);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
  }

  .sb-masonry {
    position: relative;
    min-height: min(84vh, 760px);
    border-radius: 1.5rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 10%, rgb(191 219 254 / 38%), transparent 42%),
      radial-gradient(circle at 86% 84%, rgb(186 230 253 / 28%), transparent 36%),
      linear-gradient(160deg, rgb(248 250 252), rgb(241 245 249));
    border: 1px solid rgb(226 232 240);
    padding: 1rem;
  }

  :global(.dark) .sb-masonry {
    background:
      radial-gradient(circle at 12% 10%, rgb(30 64 175 / 32%), transparent 42%),
      radial-gradient(circle at 86% 84%, rgb(8 47 73 / 38%), transparent 36%),
      linear-gradient(160deg, rgb(2 6 23), rgb(15 23 42));
    border-color: rgb(30 41 59);
  }

  .sb-masonry-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(140px, 18vw);
    grid-template-rows: repeat(6, minmax(68px, 1fr));
    gap: 1rem;
    width: max-content;
    min-height: 100%;
    padding-right: 14vw;
  }

  .sb-masonry-card {
    border-radius: 1rem;
    overflow: hidden;
    margin: 0;
    box-shadow: 0 20px 40px rgb(2 6 23 / 18%);
    transform-origin: center;
    will-change: transform;
  }

  .sb-span-sm { grid-row: span 2; }
  .sb-span-md { grid-row: span 3; }
  .sb-span-lg { grid-row: span 4; }
  .sb-span-xl { grid-row: span 5; }

  .sb-masonry-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 960px) {
    .sb-masonry { min-height: 72vh; }
    .sb-masonry-track {
      grid-auto-columns: minmax(180px, 58vw);
      padding-right: 24vw;
    }
  }
</style>