---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const { 

  action = '',
  method = 'POST',
  inputs, 
  textarea = {
    label: 'Message',
    required: true,
  }, 
  disclaimer, 
  button = 'Contact us', 
  description = '' 

  } = Astro.props;
  // Display success or error messages based on the form submission result
  function displayMessage(messageId: string) {
    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');

    if (messageId === 'success-message') {
      successMessage?.classList.remove('hidden');
      errorMessage?.classList.add('hidden');
    } else if (messageId === 'error-message') {
      errorMessage?.classList.remove('hidden');
      successMessage?.classList.add('hidden');
    }
  }
---

<form action={action} method={method}>
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', value = '', required = false }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                value={value}
                required={required}
                class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div class="grid columns-2 pd-8">
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          required={textarea.required}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            required={true}
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit" x-on:click={() => displayMessage('success-message')}>
          {button}
        </Button>
      </div>
    )
  }

  <div id="success-message" class="hidden mt-4 text-green-600 dark:text-green-400">
    Thank you for your message! We will get back to you soon.
  </div>
  <div id="error-message" class="hidden mt-4 text-red-600 dark:text-red-400">
    Oops! Something went wrong. Please try again later.
  </div>

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }
  

  <!-- Optional: But Recommended: To Prevent SPAM Submission. Make sure its hidden by default -->
  <input type="checkbox" name="botcheck" id="" class="hidden">
</form>
