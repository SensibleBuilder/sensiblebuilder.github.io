---
interface Props {
  size?: string;
  color?: string;
  class?: string;
}

const { size = '100%', color = '#3BBD5E', class: className } = Astro.props;
const animationStyle = `--anim-size: ${size}; --anim-color: ${color};`;
---

<div class:list={['completed-animation-container', className]} style={animationStyle}>
  <svg viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg">
    <!-- Main Scene Group -->
    <g class="scene">
      <!-- Filled Green Circle (elastic bounce) -->
      <circle class="bg-circle" cx="64" cy="64" r="40"></circle>

      <!-- Checkmark (trim path animation) -->
      <path class="checkmark" d="M 44 67 L 59 80 L 83 52" stroke-dasharray="62.37" stroke-dashoffset="62.37"></path>
    </g>

    <!--
      Cardinal + diagonal burst lines: each is drawn INNER -> OUTER
      (x1,y1 = point nearer the circle, x2,y2 = point further out),
      so the dash-draw animation grows outward from the circle, not inward.
    -->
    <g class="burst-cardinal">
      <line class="burst-line" x1="66" y1="28" x2="66" y2="11"></line>
      <!-- top -->
      <line class="burst-line" x1="101" y1="65" x2="118" y2="65"></line>
      <!-- right -->
      <line class="burst-line" x1="66" y1="101" x2="66" y2="118"></line>
      <!-- bottom -->
      <line class="burst-line" x1="30" y1="65" x2="13" y2="65"></line>
      <!-- left -->
    </g>

    <g class="burst-diagonal">
      <line class="burst-line" x1="92" y1="40" x2="104" y2="28"></line>
      <!-- top-right -->
      <line class="burst-line" x1="91" y1="90" x2="103" y2="102"></line>
      <!-- bottom-right -->
      <line class="burst-line" x1="38" y1="89" x2="26" y2="101"></line>
      <!-- bottom-left -->
      <line class="burst-line" x1="38" y1="40" x2="26" y2="28"></line>
      <!-- top-left -->
    </g>

    <!--
      Firefly particles: spawn at the checkmark's finishing tip (~83,52)
      once the checkmark completes, flying outward along the direction
      of its last stroke (bottom-left -> top-right, ~-49°).
    -->
    <g class="fireflies">
      <circle class="firefly f1" cx="100" cy="47" r="3"></circle>
      <circle class="firefly f2" cx="90" cy="38" r="3"></circle>
      <circle class="firefly f3" cx="99" cy="38" r="4"></circle>
    </g>
  </svg>
</div>

<style>
  .completed-animation-container {
    width: var(--anim-size);
    height: var(--anim-size);
    display: inline-block;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /*
    Every animated piece gets a static "not yet played" resting state
    here, unconditionally. The actual `animation` is only granted under
    .is-playing below, so nothing moves just because the component is
    mounted in the DOM (e.g. kept alive off-screen for layout purposes).
  */

  /* --- Circle --- */
  .bg-circle {
    fill: var(--anim-color);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
  }

  .completed-animation-container.is-playing .bg-circle {
    animation: circle-bounce 1500ms forwards;
  }

  @keyframes circle-bounce {
    0% {
      transform: scale(0);
    }
    15.5% {
      transform: scale(1);
    } /* frame 7: full size */
    26.7% {
      transform: scale(0.928);
    } /* frame 12: undershoot */
    35.5% {
      transform: scale(1);
    } /* frame 16: overshoot back to rest */
    100% {
      transform: scale(1);
    }
  }

  /* --- Checkmark --- */
  .checkmark {
    fill: none;
    stroke: white;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }

  .completed-animation-container.is-playing .checkmark {
    animation: checkmark-draw 1500ms forwards;
  }

  @keyframes checkmark-draw {
    0%,
    32.9% {
      stroke-dashoffset: 62.37;
      opacity: 0;
    } /* frames 0-14.79: not yet drawing */
    44% {
      stroke-dashoffset: 42.41;
      opacity: 1;
    } /* frame 19.79: ~32% drawn */
    55.1% {
      stroke-dashoffset: 0;
      opacity: 1;
    } /* frame 24.79: fully drawn */
    100% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  /* --- Burst lines --- */
  .burst-line {
    stroke: var(--anim-color);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 17;
    stroke-dashoffset: 17;
    transform-box: fill-box;
    transform-origin: center;
  }

  .completed-animation-container.is-playing .burst-cardinal .burst-line {
    animation: burst-cardinal-anim 1500ms forwards;
  }

  @keyframes burst-cardinal-anim {
    0%,
    15.5% {
      stroke-dashoffset: 17;
    } /* frame 7: hidden, ready at the circle */
    22.2% {
      stroke-dashoffset: 11.3;
    } /* frame 10: head has grown ~33% out */
    35.5% {
      stroke-dashoffset: -17;
    } /* frame 16: tail has caught head, gone */
    100% {
      stroke-dashoffset: -17;
    }
  }

  .completed-animation-container.is-playing .burst-diagonal .burst-line {
    animation: burst-diagonal-anim 1500ms forwards;
  }

  @keyframes burst-diagonal-anim {
    0%,
    22.2% {
      stroke-dashoffset: 17;
    } /* frame 10: hidden */
    28.9% {
      stroke-dashoffset: 11.3;
    } /* frame 13: head has grown ~33% out */
    42.2% {
      stroke-dashoffset: -17;
    } /* frame 19: gone */
    100% {
      stroke-dashoffset: -17;
    }
  }

  /* --- Fireflies --- */
  .firefly {
    fill: white;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    transform: scale(0);
  }

  .completed-animation-container.is-playing .f1 {
    animation: firefly-1 1500ms forwards;
  }
  .completed-animation-container.is-playing .f2 {
    animation: firefly-2 1500ms forwards;
  }
  .completed-animation-container.is-playing .f3 {
    animation: firefly-3 1500ms forwards;
  }

  /* Firefly 1: shallow angle, mostly right, slightly up (-18.1°) */
  @keyframes firefly-1 {
    0%,
    53.3% {
      opacity: 0;
      transform: translate(0, 0) scale(0.44);
    }
    55.6% {
      opacity: 1;
      transform: translate(1px, -0.3px) scale(0.6);
    }
    60% {
      opacity: 1;
      transform: translate(4.5px, -1.5px) scale(1);
    }
    64.4% {
      opacity: 1;
      transform: translate(8.2px, -2.7px) scale(0.95);
    }
    84.4% {
      opacity: 0;
      transform: translate(18.1px, -5.9px) scale(0.2);
    }
    100% {
      opacity: 0;
      transform: translate(18.1px, -5.9px) scale(0.2);
    }
  }

  /* Firefly 2: steep angle, mostly up, slightly right (-72.5°) */
  @keyframes firefly-2 {
    0%,
    53.3% {
      opacity: 0;
      transform: translate(0, 0) scale(0.44);
    }
    55.6% {
      opacity: 1;
      transform: translate(0.3px, -1px) scale(0.6);
    }
    60% {
      opacity: 1;
      transform: translate(1.4px, -4.5px) scale(1);
    }
    64.4% {
      opacity: 1;
      transform: translate(2.6px, -8.2px) scale(0.95);
    }
    84.4% {
      opacity: 0;
      transform: translate(5.8px, -18.2px) scale(0.2);
    }
    100% {
      opacity: 0;
      transform: translate(5.8px, -18.2px) scale(0.2);
    }
  }

  /* Firefly 3: 45° up-right, same line as the checkmark's final stroke (-45.7°) */
  @keyframes firefly-3 {
    0%,
    53.3% {
      opacity: 0;
      transform: translate(0, 0) scale(0.44);
    }
    55.6% {
      opacity: 1;
      transform: translate(1px, -1px) scale(0.6);
    }
    60% {
      opacity: 1;
      transform: translate(5px, -5.1px) scale(1);
    }
    64.4% {
      opacity: 1;
      transform: translate(9px, -9.2px) scale(0.95);
    }
    84.4% {
      opacity: 0;
      transform: translate(20px, -20.5px) scale(0.2);
    }
    100% {
      opacity: 0;
      transform: translate(20px, -20.5px) scale(0.2);
    }
  }
</style>
