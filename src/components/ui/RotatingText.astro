---
export interface Props {
  prefix?: string;
  items?: string[];
  /** Tailwind / utility classes */
  class?: string; // root: set type scale, weight, gap, etc. here
  prefixClass?: string; // e.g. "text-neutral-900"
  accentClass?: string; // e.g. "text-rose-700"
  /** timing */
  hold?: number;
  speed?: number;
  switchDelay?: number;
  enterEase?: string;
  rewind?: boolean;
  rewindEase?: string;
  rewindScale?: number;
  autoplay?: boolean;
}

const {
  prefix = 'Through',
  items = ['Innovation.', 'Machine Learning.', 'Artificial Intelligence.'],
  class: className = '',
  prefixClass = '',
  accentClass = '',
  hold = 1.4,
  speed = 0.6,
  switchDelay = 0.12,
  enterEase = 'back.out(1.7)',
  rewind = true,
  rewindEase = 'power2.inOut',
  rewindScale = 0.55,
  autoplay = true,
} = Astro.props;

const longest = items.reduce((a, b) => (b.length > a.length ? b : a), items[0] ?? '');
const rows = rewind ? items : [...items, items[0]]; // clone = step-up wrap fallback

const opts = JSON.stringify({
  hold,
  speed,
  switchDelay,
  enterEase,
  rewind,
  rewindEase,
  rewindScale,
  autoplay,
  clone: !rewind,
});
---

<span
  data-rotator
  data-options={opts}
  class={`rotator ${className}`}
  aria-label={`${prefix} ${items.join(' ')}`.trim()}
>
  {
    prefix && (
      <span class={`prefix ${prefixClass}`} aria-hidden="true">
        {prefix}
      </span>
    )
  }

  <span class="sizer" data-sizer>
    <!-- reserves the outer footprint (tallest likely item) → no layout shift -->
    <span class="ghost ghost-max">{longest}</span>

    <span class={`swap ${accentClass}`}>
      <!-- reserves the pre-hydration window height (first item, exact) -->
      <span class="ghost ghost-0">{items[0]}</span>

      <span class="clip" data-clip>
        <span class="reel" data-reel>
          {rows.map((row) => <span class="row">{row}</span>)}
        </span>
      </span>
    </span>
  </span>
</span>

<style>
  .rotator {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* normal leading = the font's own content box → mask always contains full glyphs */
  .prefix {
    display: block;
    line-height: var(--rt-leading, normal);
  }

  .sizer {
    position: relative;
    display: block;
    width: 100%;
    line-height: var(--rt-leading, normal); /* rows + both ghosts inherit this */
  }
  .ghost {
    display: block;
    visibility: hidden;
  }

  .swap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
  }

  .clip {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .reel {
    position: relative;
    display: block;
    will-change: transform;
  }
  .row {
    display: block;
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-rotator]').forEach((root) => {
    const o = JSON.parse(root.dataset.options || '{}');
    const sizer = root.querySelector<HTMLElement>('[data-sizer]')!;
    const clip = root.querySelector<HTMLElement>('[data-clip]')!;
    const reel = root.querySelector<HTMLElement>('[data-reel]')!;
    const rowEls = Array.from(reel.children) as HTMLElement[];

    let m: { top: number; h: number }[] = [];
    let tl: gsap.core.Timeline | undefined;
    let idx = 0;
    let resizeT: ReturnType<typeof setTimeout>;

    // float-precise layout metrics; transform neutralized so mid-anim resizes measure clean
    const measure = () => {
      gsap.set(reel, { y: 0 });
      const base = reel.getBoundingClientRect().top;
      m = rowEls.map((el) => {
        const r = el.getBoundingClientRect();
        return { top: r.top - base, h: r.height };
      });
      sizer.style.minHeight = Math.max(...m.map((x) => x.h)) + 'px';
    };

    const setTo = (i: number) => {
      gsap.set(reel, { y: -m[i].top });
      gsap.set(clip, { height: m[i].h });
    };

    const build = () => {
      tl?.kill();
      measure();
      if (!o.autoplay || reduce) {
        tl = undefined;
        setTo(0);
        return;
      }
      setTo(0);

      tl = gsap.timeline({ repeat: -1 });
      tl.addLabel('item-0')
        .call(() => {
          idx = 0;
        })
        .addLabel('rest-0')
        .to({}, { duration: o.hold });

      for (let i = 1; i < rowEls.length; i++) {
        tl.addLabel(`item-${i}`, `+=${o.switchDelay}`)
          .call(() => {
            idx = i;
          })
          // same curve for reel + mask → they travel in lockstep
          .fromTo(
            reel,
            { y: -m[i - 1].top },
            { y: -m[i].top, duration: o.speed, ease: o.enterEase, immediateRender: false },
            '<'
          )
          .fromTo(
            clip,
            { height: m[i - 1].h },
            { height: m[i].h, duration: o.speed, ease: o.enterEase, immediateRender: false },
            '<'
          )
          .addLabel(`rest-${i}`)
          .to({}, { duration: o.hold });
      }

      if (o.rewind) {
        const last = rowEls.length - 1;
        const d = Math.max(o.speed, o.speed * last * o.rewindScale);
        tl.addLabel('rewind', `+=${o.switchDelay}`)
          .fromTo(reel, { y: -m[last].top }, { y: 0, duration: d, ease: o.rewindEase, immediateRender: false })
          .fromTo(
            clip,
            { height: m[last].h },
            { height: m[0].h, duration: d, ease: o.rewindEase, immediateRender: false },
            '<'
          );
      } else if (o.clone) {
        tl.call(() => {
          idx = 0;
          setTo(0);
        });
      }
    };

    const restore = (keep: number) => (tl ? tl.seek(`rest-${keep}`, true) : setTo(0));

    build();
    restore(0);

    const onResize = () => {
      measure(); // glue the current row while sizes change
      setTo(idx);
      tl?.pause();
      clearTimeout(resizeT);
      resizeT = setTimeout(() => {
        build();
        restore(Math.min(idx, rowEls.length - 1));
        tl?.play();
      }, 150);
    };

    if ('ResizeObserver' in window) new ResizeObserver(onResize).observe(sizer);
    else addEventListener('resize', onResize);

    document.fonts?.ready.then(() => {
      build();
      restore(Math.min(idx, rowEls.length - 1));
    });
  });
</script>
